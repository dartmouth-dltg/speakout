{
  "name": "@dltg/gulp-build",
  "version": "2.0.2",
  "description": "Common Gulp build configuration, plus shareable ESLint/Stylelint configs, for Library frontend projects",
  "scripts": {
    "test": "gulp",
    "lint:fix": "eslint --fix ."
  },
  "main": "index.js",
  "files": [
    "index.js",
    "gulpfuncs.js",
    "eslint-config.js",
    "stylelint-config.json",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./eslint-config": "./eslint-config.js",
    "./stylelint-config": "./stylelint-config.json",
    "./stylelint-config.json": "./stylelint-config.json"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "gulp": "^5.0.0"
  },
  "overrides": {
    "eslint-config-airbnb-base": {
      "eslint": "$eslint"
    },
    "file-entry-cache": "^8.0.0",
    "immutable": "^4.3.9",
    "@gulp-sourcemaps/identity-map": {
      "postcss": "^8.5.23"
    }
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.9.0",
    "@ronilaukkarinen/gulp-stylelint": "^14.1.1",
    "autoprefixer": "^10.4.19",
    "browser-sync": "^3.0.2",
    "cssnano": "^7.0.5",
    "eslint": "^9.9.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-yml": "^1.14.0",
    "globals": "^15.9.0",
    "gulp": "^5.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-sass": "^5.1.0",
    "gulp-sass-glob": "^1.1.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-terser": "^2.1.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "sass": "^1.77.8",
    "stylelint": "^15.10.3",
    "stylelint-config-standard": "^33.0.0",
    "stylelint-config-standard-scss": "^10.0.0",
    "stylelint-order": "^6.0.3",
    "stylelint-prettier": "^4.0.2",
    "stylelint-scss": "^5.1.0"
  }
}